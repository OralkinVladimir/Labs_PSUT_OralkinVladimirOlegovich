#include <iostream>
using namespace std;

int main() {
    const int n = 5;
    int a[n] = {1, 2, 3, 4, 5};

    // Переворот массива
    for (int i = 0; i < n / 2; i++) {
        int temp = a[i];
        a[i] = a[n - 1 - i];
        a[n - 1 - i] = temp;
    }

    // Вывод результата
    cout << "Перевернутый массив: ";
    for (int i = 0; i < n; i++) {
        cout << a[i] << " ";
    }
    cout << endl;

    return 0;
}