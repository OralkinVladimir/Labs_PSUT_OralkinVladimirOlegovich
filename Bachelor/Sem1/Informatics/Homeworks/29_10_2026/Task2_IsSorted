#include <iostream>
using namespace std;

int main() {
    const int n = 6;
    int a[n] = {2, 4, 5, 7, 8, 9}; // Попробуйте изменить на {2, 5, 4, 7, 8, 9}
    
    bool isSorted = true; // Флажок

    for (int i = 1; i < n; i++) {
        if (a[i] < a[i - 1]) {
            isSorted = false;
            break; // Нарушение найдено, дальше проверять нет смысла
        }
    }

    if (isSorted) {
        cout << "Массив упорядочен по возрастанию." << endl;
    } else {
        cout << "Массив НЕ упорядочен по возрастанию." << endl;
    }

    return 0;
}